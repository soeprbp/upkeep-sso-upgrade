NEXT_PUBLIC_BASE_PATH=
UPKEEP_COMPANY_ID=
UPKEEP_API_BASE_URL=https://api.onupkeep.com/api/v2

# --- Authentication (required for all modes) ---
UPKEEP_EMAIL=
UPKEEP_PASSWORD=

# --- Multi-site config ---
# Comma-separated "SiteName:siteUserId" entries.
# Authentication happens once via UPKEEP_EMAIL, then each site is
# accessed through the switch-site endpoint using its siteUserId.
# Get siteUserIds from the UpKeep GraphQL UserSites query.
# Example: UPKEEP_SITES=ELK:oRytiVJk22,IND:AJDBEKFanS
UPKEEP_SITES=
# Demo Site is excluded by default. Set true only for an explicitly requested demo operation.
UPKEEP_INCLUDE_DEMO_SITE=false
# Demo Site and Green Meadows Paper Company are ignored by default.
# Use a comma-separated exact site name only for an explicitly requested operation.
UPKEEP_INCLUDE_IGNORED_SITES=

UPKEEP_SESSION_TOKEN=
UPKEEP_USERS_ENDPOINT=/users
UPKEEP_TIMEOUT_MS=15000
UPKEEP_PAGE_SIZE=200
UPKEEP_MAX_PAGES=20
UPKEEP_EXPECTED_MIN_USERS=117

# --- Response cache ---
# Set to "false" to disable caching (default: enabled)
UPKEEP_CACHE_ENABLED=true
# Cache TTL in milliseconds (default: 3600000 = 1 hour)
UPKEEP_CACHE_TTL_MS=3600000
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
PAYROLL_SQL_SERVER=SVWPDBS04
PAYROLL_SQL_DATABASE=
PAYROLL_SQL_TABLE=EMP_INFO
PAYROLL_SQL_CONNECTION_STRING=
PAYROLL_SQL_QUERY=
PAYROLL_SQL_TRUST_SERVER_CERTIFICATE=false
