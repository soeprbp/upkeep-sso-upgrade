# Safe default: local fixture inventory and no UpKeep connection.
UPKEEP_LABEL_MODE=fixture

# Required only when UPKEEP_LABEL_MODE=live. Values are read server-side only.
UPKEEP_EMAIL=
UPKEEP_PASSWORD=
# Optional legacy override. Normal operation authenticates with email/password.
UPKEEP_SESSION_TOKEN=
UPKEEP_API_BASE_V2=https://api.onupkeep.com/api/v2
UPKEEP_API_BASE_V3=https://api.onupkeep.com/api/v3

# Keep false for browser development unless you are deliberately testing a reviewed live write.
UPKEEP_LABEL_ALLOW_WRITES=false
